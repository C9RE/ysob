{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YSOB",
  "mainBinaryName": "ysob-desktop",
  "version": "0.2.3",
  "identifier": "wtf.yousonofabitch.app",
  "build": {
    "frontendDist": "../boot",
    "beforeBuildCommand": "bun prep.js",
    "beforeDevCommand": "bun prep.js"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Run a squad of AI coding agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ysob"
    ],
    "resources": {
      "../../ui/dist/": "ui/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "createUpdaterArtifacts": false,
    "longDescription": "YSOB runs your AI coding agents as a squad on your own machine: one leads, the rest take the jobs, and nothing is done without proof.",
    "publisher": "YSOB contributors",
    "copyright": "MIT licence, YSOB contributors"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
